# ---------------------------------------------------------------------------
# Sector Research MCP — environment variables
# Copy to `.env` and fill in. Every key is optional; tools that need a missing
# key return a structured error instead of crashing, so the server always boots.
# ---------------------------------------------------------------------------

# Primary discovery / scraping layer (required for web_search + extract_url).
# https://docs.tavily.com/
TAVILY_API_KEY=

# Crypto / digital-asset fundamentals (stablecoins, protocols, market data).
# https://messari.io/api
MESSARI_API_KEY=

# On-chain + market data (spot, DeFi, transfers).
# https://docs.amberdata.io/
AMBERDATA_API_KEY=

# --- Free / keyless sources (no key required, but configure politely) --------

# SEC EDGAR requires a descriptive User-Agent with a contact email.
# https://www.sec.gov/os/webmaster-faq#developers
SEC_EDGAR_USER_AGENT=sector-research-mcp (contact: you@example.com)

# CoinGecko works keyless on the public tier; a demo/pro key raises limits.
# https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# DefiLlama is fully keyless (no variable needed).

# --- Output -----------------------------------------------------------------
# Where rendered .md and .pdf memos are written. Defaults to ./reports
SECTOR_RESEARCH_OUTPUT_DIR=
